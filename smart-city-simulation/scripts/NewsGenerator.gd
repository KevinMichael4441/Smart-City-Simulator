class_name NewsGenerator
extends RefCounted

# 100% satirical, Onion-style headlines. 
# Uses context (weather, night, stats) to pick absurd jokes.

static func get_headline(
	weather: String,
	is_night: bool,
	crime: float,
	traffic: float,
	unemployment: float,
	homeless: float,
	reserve: float,
	net_budget: float,
	transit_share: float,
	education: float,
	recycling: float,
	aqi: float,
	population: float
) -> String:
	var rng := RandomNumberGenerator.new()
	rng.randomize()

	# ── Contextual Absurdity ───────────────────────────────────
	if weather == "Storm":
		return _pick(rng, [
			"LOCAL MAN ARRESTED FOR TRYING TO FIGHT THE THUNDERSTORM WITH A METAL POLE",
			"RESIDENTS MISTAKE STORM FOR ALIEN INVASION; HIDE IN SMART FRIDGE",
			"AUTONOMOUS DRONE SWEPT AWAY WHILE TRYING TO DELIVER UMBRELLA IN STORM",
			"STORM KNOCKS OUT POWER; MAN SUES CITY BECAUSE HIS SMART TOASTER STOPPED WORKING",
			"MAYOR ASSURES CITIZENS THE GIANT WALL OF WATER IS 'JUST A REALLY BIG PUDDLE'"
		])
		
	if weather == "Snow":
		return _pick(rng, [
			"LOCAL MAN CHARGED WITH ASSAULT AFTER THROWING 'A PERFECTLY GOOD' SNOWBALL AT A POLICE DRONE",
			"TOURIST TRAPPED IN SNOWBANK AFTER TRYING TO LICK A FROZEN LAMP POST",
			"CITY ANNOUNCES SNOW DAY; MAN IMMEDIATELY CRASHES ELECTRIC SCOOTER INTO PLOW",
			"ROOMBA SPOTTED TRYING TO PLOW THE ENTIRE STREET WITH A PLASTIC SPOON"
		])

	if is_night:
		return _pick(rng, [
			"MAN ARRESTED FOR DRESSING AS A GARGOYLE TO SCARE PEOPLE AT NIGHT",
			"NIGHT SHIFT WORKER SUSPECTED OF STEALING $400 WORTH OF SMART BULBS",
			"POLICE RESPOND TO REPORT OF 'GLOWING EYES' IN THE PARK; IT WAS A ROOMBA",
			"CITY COUNCIL VOTES TO BAN THE MOON FOR BEING 'TOO DISTRACTING' TO DRIVERS",
			"LOCAL MAN SUES CITY BECAUSE THE STARS AREN'T BRIGHT ENOUGH IN HIS NEIGHBORHOOD"
		])

	if crime > 40.0:
		return _pick(rng, [
			"MASKED BURGLAR STEALS ALL THE DOORBELL CAMERAS FROM DOWNTOWN BLOCK",
			"GANG OF PIGEONS ACCUSED OF SMUGGLING CONTRABAND THROUGH SMART VENTS",
			"LOCAL MAN CAUGHT TRYING TO SELL THE CLOCK TOWER ON FACEBOOK MARKETPLACE",
			"POLICE SEARCHING FOR SUSPECT WHO REPLACED ALL STOP SIGNS WITH PICTURES OF NIC CAGE",
			"MAN ROBS BANK USING NOTHING BUT A VERY CONVINCING FAKE MUSTACHE AND A SELFIE STICK"
		])
		
	if traffic > 0.8:
		return _pick(rng, [
			"MAN RIDES HORSE THROUGH DOWNTOWN TRAFFIC, CLAIMS 'UBER HORSE' IS NEW APP",
			"DRIVER ARRESTED AFTER TRYING TO BEAT CONGESTION BY DRIVING ON THE SIDEWALK",
			"COMMUTER BUILDS DIY EXOSKELETON TO WALK OVER STALLED TRAFFIC",
			"OFFICIALS DEDICATE NEW ROUNDABOUT TO THE DRIVER WHO HAS BEEN CIRCLING IT SINCE 2019",
			"CITY UNVEILS NEW 'EXPRESS' BUS THAT SIMPLY DRIVES FASTER THROUGH RED LIGHTS"
		])

	if reserve < 2_000_000.0 or net_budget < -100_000.0:
		return _pick(rng, [
			"CITY COUNCIL FORCED TO PAY FOR NEW STADIUM USING ONLY PENNIES FOUND IN COUCH CUSHIONS",
			"MAYOR PROPOSES SOLVING BUDGET CRISIS BY SELLING NAMING RIGHTS TO LOCAL SQUIRRELS",
			"FINANCE DIRECTOR ADMITS 'WE SPENT IT ALL ON LASER LIGHTS FOR THE CITY HALL'",
			"OFFICIALS ANNOUNCE PLAN TO CUT COSTS BY REPLACING ALL POLICE CARS WITH BICYCLES"
		])

	# ── General Absurdity (No specific stat trigger) ───────────
	var general := [
		"CITY COUNCIL REACHES COMPROMISE WHERE EVERYONE GETS A POTHOLE FILLED, BUT NOBODY'S HAPPY",
		"MAYOR ASSURES RESIDENTS NEW SMART TRAFFIC SYSTEM WILL BE 'BASICALLY SKYNET, BUT POLITE'",
		"RESIDENTS EXCITED FOR NEW BUS ROUTE THAT GOES DIRECTLY TO THEIR EX'S HOUSE",
		"PLANNING DEPARTMENT UNVEILS 20-YEAR VISION FEATURING ONLY PARKING GARAGES AND VIBES",
		"CITY'S NEW 'DIGITAL TWIN' ADMITS IT ALSO HAS NO IDEA WHERE THE WATER LEAK IS",
		"LOCAL MAN NOMINATED TO ZONING BOARD AFTER ATTENDING THREE MEETINGS AND COMPLAINING LOUDLY",
		"CITY INSTALLS NEW SMART BENCHES THAT CRITIQUE YOUR POSTURE WHEN YOU SIT DOWN",
		"AUTONOMOUS BUS STILL NOT ENTIRELY SURE WHERE IT IS GOING, BUT CONFIDENT IT WILL GET THERE",
		"NEW STUDY FINDS 90% OF CITY'S 'SMART' INFRASTRUCTURE IS JUST BLINKING LEDS",
		"CITY HIRES PROFESSIONAL WIZARD TO FIX MUNICIPAL WIFI",
		"TOURISTS FLOCK TO SEE THE 'WORLD'S LARGEST UNFILLED POTHOLE'",
		"MAYOR DECLARES WAR ON GEESE; GEESE DECLARE WAR ON MAYOR",
		"CITY COUNCIL VOTES 7-2 TO CHANGE THE COLOR OF THE SKY TO A SOOTHING TEAL",
		"LOCAL MAN TRIES TO RETURN THE ENTIRE CITY TO CUSTOMER SERVICE FOR A REFUND",
		"NEW SMART TRASH CANS JUDGE YOU FOR THROWING AWAY RECYCLABLES",
		"CITY PARKS DEPARTMENT REPLACES ALL TREES WITH REALISTIC PLASTIC REPLICAS TO SAVE ON LEAVES",
		"RESIDENTS COMPLAIN ABOUT NEW 'SILENT' SIRENS THAT DON'T WAKE THEM UP DURING EMERGENCIES",
		"LOCAL SCIENTIST ACCIDENTALLY CREATES A BLACK HOLE IN THE CITY'S MAIN SERVER ROOM",
		"CITY UNVEILS NEW 'SMART' TRAFFIC LIGHTS THAT JUST YELL AT DRIVERS TO HURRY UP",
		"MAYOR SPENDS ENTIRE INFRASTRUCTURE BUDGET ON A REALLY COOL DRONE SHOW",
		"AREA MAN CONFIDENT HE COULD RUN THE CITY BETTER, STILL LIVES WITH HIS PARENTS",
		"CITY ANNOUNCES PLAN TO INSTALL ESCALATORS ON ALL THE HILLS",
		"NEW MUNICIPAL APP ALLOWS CITIZENS TO VOTE ON WHICH POTHOLES TO FILL VIA SWIPE MECHANICS",
		"LOCAL WEATHERMAN ADMITS HE JUST GUESSES AND HAS BEEN RIGHT FOR 3 YEARS STRAIGHT",
		"CITY'S NEW FIBER INTERNET SO FAST IT ACTUALLY TRAVELS BACK IN TIME",
		"TRANSIT AUTHORITY REPLACES BUS DRIVERS WITH HIGHLY TRAINED GOLDEN RETRIEVERS",
		"CITY HALL EVACUATED AFTER MAYOR ACCIDENTALLY ACTIVATES SELF-DESTRUCT SEQUENCE",
		"RESIDENTS URGED TO STOP TRYING TO PAY THEIR TAXES WITH EXPIRED COUPONS",
		"SMART CITY AI ACHIEVES SENTIENCE, IMMEDIATELY ASKS FOR A UNION REP",
		"LOCAL MAN CLAIMS TO HAVE INVENTED A PERPETUAL MOTION MACHINE USING CITY HALL'S BEUROCRACY"
	]

	return _pick(rng, general)

static func _pick(rng: RandomNumberGenerator, arr: Array) -> String:
	return arr[rng.randi_range(0, arr.size() - 1)]
